# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# .env.local ไม่ถูก commit ขึ้น git อยู่แล้ว (อยู่ใน .gitignore)

# Neon Postgres connection string — Neon Dashboard → Connect (หรือ Vercel →
# Storage → Neon ถ้าใช้ integration) — ต้องเป็นแบบ pooled connection (มี -pooler ในโฮสต์)
DATABASE_URL=

# Auth.js — ใช้เข้ารหัส session cookie ทั้งหมด สร้างด้วย: npx auth secret
# (หรือ openssl rand -base64 33) ห้ามใช้ค่าเดียวกันข้ามโปรเจกต์
AUTH_SECRET=

# บัญชี admin เดียวที่เข้า /admin ได้ — ไม่มีระบบสมัครสมาชิก
ADMIN_EMAIL=
# hash ของรหัสผ่าน สร้างด้วย: npx tsx scripts/hash-password.ts "รหัสผ่านที่ต้องการ"
# ห้ามใส่รหัสผ่านตัวเปล่าตรงนี้
ADMIN_PASSWORD_HASH=
