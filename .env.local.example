# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงจาก Supabase project ของคุณ
# (Supabase Dashboard → Project Settings → API)
# .env.local ไม่ถูก commit ขึ้น git อยู่แล้ว (อยู่ใน .gitignore)

# Project URL — เช่น https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key — ปลอดภัยที่จะฝังฝั่ง client เพราะถูกป้องกันด้วย Row Level Security
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — ⚠️ ข้ามการตรวจ RLS ทั้งหมด ใช้เฉพาะฝั่งเซิร์ฟเวอร์เท่านั้น
# (lib/supabase/admin.ts) ห้ามใส่ NEXT_PUBLIC_ นำหน้า และห้าม commit ขึ้น git เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=
