# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# .env.local ไม่ถูก commit ขึ้น git อยู่แล้ว (อยู่ใน .gitignore)

# Neon Postgres connection string — Neon Dashboard → Connect (หรือ Vercel →
# Storage → Neon ถ้าใช้ integration) — ต้องเป็นแบบ pooled connection (มี -pooler ในโฮสต์)
DATABASE_URL=

# Auth.js — ใช้เข้ารหัส session cookie ทั้งหมด สร้างด้วย: npx auth secret
# (หรือ openssl rand -base64 33) ห้ามใช้ค่าเดียวกันข้ามโปรเจกต์
AUTH_SECRET=

# บัญชี admin เดียวที่เข้า /admin ได้ — ไม่มีระบบสมัครสมาชิก
ADMIN_EMAIL=
# hash ของรหัสผ่าน (base64) สร้างด้วย: npx tsx scripts/hash-password.ts "รหัสผ่านที่ต้องการ"
# ห้ามใส่รหัสผ่านตัวเปล่าตรงนี้ — ที่เป็น base64 เพราะ bcrypt hash ดิบขึ้นต้นด้วย $2b$10$
# ซึ่ง Next.js และช่อง env var ของ Vercel จะ expand $... เป็นตัวแปรแล้วทำให้ค่าหายทั้งก้อน
ADMIN_PASSWORD_HASH=

# API key ของ data.go.th (ไม่บังคับ — ใส่เมื่อจะใช้แท็บ "API ข้อมูลเปิด" ใน /admin)
# ขอได้จากหน้าโปรไฟล์ผู้ใช้ที่ data.go.th · ส่งผ่าน header ชื่อ api-key · อ่านฝั่งเซิร์ฟเวอร์เท่านั้น
DATA_GO_TH_API_KEY=
